library(ggplot2);library(MASS);library(nlme);library(glmmTMB)

df<-read.table("MYCab")
df[, 1:3] <- df[, 1:3] / rowSums(df[, 1:3], na.rm = TRUE)
df[] <- lapply(df, function(x) if (is.character(x)) as.factor(x) else x)
df$Elevation<-as.numeric(df$elevation)
df$Time<-as.numeric(df$Time)


df$MAT  <- scale(df$MAT)
df$MAP  <- scale(df$MAP)
df$Lattitude  <- scale(df$Lattitude)
df$elevation <- scale(df$elevation)
df[] <- lapply(df, function(x) if (is.character(x)) as.factor(x) else x)
df$Elevation<-as.numeric(df$elevation)
df$Time<-as.numeric(df$Time)




y<-cbind(df$Site,df$Vegetationtype, 
         df$MAT, df$MAP, df$Lattitude, df$Elevation, df$Time)
colnames(y) <- c("Site", "Vegetation", "MAT", "MAP", "Lattitude", "Elevation","Time")
#bind alles behalve score
pc <-princomp(y,cor=T)


biplot(pc, pc.biplot=T)



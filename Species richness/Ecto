library(vegan);library(ggplot2);library(glmmTMB)

Taxon<-read.table('ASV_taxonomy_lou.txt') 
ASVmatrix<-read.table(as.matrix("rarefied_fungi.txt")) 
META<-read.table("Metadata_general.csv", header=T, sep=";", dec=",")
Traits<-read.table('f_traits_arr.txt', header=T)


Genus <- Taxon[!is.na(Taxon$Genus),]
Genus <- Genus[ , 6, drop = FALSE]
Genus$Genus <- sub("^g__", "", Genus$Genus)
names(Genus)[names(Genus) == "Genus"] <- "GENUS"
Traits <- Traits[, c(1:3)]
Traits[] <- lapply(Traits, function(x) if (is.character(x)) as.factor(x) else x)
Traits<- Traits[
  Traits$primary_lifestyle %in% c("ectomycorrhizal") 
  | Traits$Secondary_lifestyle %in% c("ectomycorrhizal"),]
ikwil <- c("ectomycorrhizal")
Traits$Mycorrhizal_type <- apply(Traits[, c("primary_lifestyle", "Secondary_lifestyle")], 1, function(x) {
  paste(unique(x[x %in% ikwil]), collapse = ",")
})
ECT <- Traits[, c("GENUS", "Mycorrhizal_type")]; ECT$GENUS<-as.character(ECT$GENUS)
Genus <- Genus[Genus$GENUS %in% ECT$GENUS,,drop=F]
ECT <- ECT[match(Genus$GENUS, ECT$GENUS),,drop=F]
Genus_ECT <- data.frame(GENUS = Genus$GENUS,Mycorrhizal_type = ECT$Mycorrhizal_type,row.names = rownames(Genus))


ASVmatrix_ECT<- ASVmatrix[ , colnames(ASVmatrix) %in% rownames(Genus_ECT), drop = FALSE]


META2<-META
rownames(META) <- META$Label2; META$Label2 <- NULL 
META=META[rownames(META) %in% rownames(ASVmatrix_ECT),]
ASVmatrix_ECT=ASVmatrix_ECT[rownames(ASVmatrix_ECT) %in% rownames(META),] 
META=META[match(rownames(ASVmatrix_ECT),rownames(META)),]
str(META)
META[] <- lapply(META, function(x) if (is.character(x)) as.factor(x) else x)
META[] <- lapply(META, function(x) if (is.integer(x)) as.factor(x) else x)
META$elevation<-as.numeric(META$elevation)



META$MAT  <- scale(META$MAT)
META$MAP  <- scale(META$MAP)
META$Lattitude  <- scale(META$Lattitude)
META$elevation <- scale(META$elevation)


#richness--------------------
richness=as.matrix(specnumber(ASVmatrix_ECT))
colnames(richness)= "richness"

META=merge(META, richness, by="row.names")
rownames(META)=META[,1]
META[,1]=NULL



ggplot(META, aes(x = Vegetationtype,
                 y = richness,
                 fill = Treatment)) +
  geom_boxplot(position = position_dodge()) +
  geom_jitter(color="black", size=0.4, alpha=0.9) +
  theme_minimal()


META <- subset(META,
               !(Vegetationtype == "Alpine grassland"   & Treatment == "C" & richness > 7 )&
                 !(Vegetationtype == "Heath" &  richness > 8 )&
                 !(Vegetationtype == "Heath" & Treatment == "OTC" &  richness > 6 )&
                 !(Vegetationtype == "Moss snowbed" &  richness > 8 )&
                 !(Site %in% c("15.ch"))&
               !(Vegetationtype == "Shrub snowbed"   & Treatment == "C" & richness > 4 )&
               !(Vegetationtype == "Wet meadow tundra" &   richness > 6 ))


#this is not the same as Fran. Nothing i can do about it.
mFr<- glmmTMB(richness~Treatment*Vegetationtype,ziformula = ~ 1,family = poisson, data = META)
sim_res <- simulateResiduals(mFr)
par(mfrow=c(2,2))
plot(sim_res)        # overall diagnostic plots
plotResiduals(sim_res, form = META$Treatment)
plotResiduals(sim_res, form = META$Vegetationtype)
testDispersion(sim_res)   # overdispersion check
testZeroInflation(sim_res)  # zero-inflation check
summary(mFr)


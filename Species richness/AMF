library("vegan");library("ggplot2");library(nlme);library(lme4); library(glmmTMB)

Taxon<-read.table('ASV_taxonomy_lou.txt')
ASVmatrix<-read.table(as.matrix("rarefied_fungi.txt")) #i have 8861 ASV's
META<-read.table("Metadata_general.csv", header=T, sep=";", dec=",")
META2<-META
Traits<-read.table('f_traits_arr.txt', header=T)


Phylum <- Taxon[!is.na(Taxon$Phylum),]
Phylum <- Phylum[ , 2, drop = FALSE]
Phylum$Phylum <- sub("^p__", "", Phylum$Phylum)
str(Phylum)
Phylum <- Phylum[Phylum$Phylum == "Glomeromycota",, drop=F ]
Phylum$Mycorrhizal_type <- "arbuscular_mycorrhizal"
#select all glomeromycota

ASVmatrix_AMF<- ASVmatrix[ , colnames(ASVmatrix) %in% rownames(Phylum), drop = FALSE]
#colnames(ASVmatrix_myc) <- Genus_mycorrhizae[colnames(ASVmatrix_myc), "GENUS"]
#make a matrix of ASVs which only has the potential mycorrhizae

rownames(META) <- META$Label2; META$Label2 <- NULL #set label2 as rownames and remove
META=META[rownames(META) %in% rownames(ASVmatrix_AMF),]
ASVmatrix_AMF=ASVmatrix_AMF[rownames(ASVmatrix_AMF) %in% rownames(META),] 
META=META[match(rownames(ASVmatrix_AMF),rownames(META)),]
str(META)
META[] <- lapply(META, function(x) if (is.character(x)) as.factor(x) else x)
META[] <- lapply(META, function(x) if (is.integer(x)) as.numeric(x) else x)
META$Elevation<-as.numeric(META$elevation)

META$MAT  <- scale(META$MAT)
META$MAP  <- scale(META$MAP)
META$Lattitude  <- scale(META$Lattitude)
META$elevation <- scale(META$elevation)
#241 samples have AMF from 279

#Richness---------------------------------------------------
richness=as.matrix(specnumber(ASVmatrix_AMF))
colnames(richness)= "richness"

META=merge(META, richness, by="row.names")
rownames(META)=META[,1]
META[,1]=NULL


Z<-cbind("Rich"= META$richness,"tt"= META$Treatment, "veg" = META$Vegetationtype, "Lat" = META$Lattitude,'Ele' = META$elevation, "MAP"= META$MAP, "MAT"= META$MAT,
         "T" =META$Time)
pairs(Z)


ggplot(META, aes(x = Vegetationtype,
                 y = richness,
                 fill = Treatment)) +
  geom_boxplot(position = position_dodge()) +
  geom_jitter(color="black", size=0.4, alpha=0.9) +
  theme_minimal()


mFr<- glmmTMB(richness~Treatment*Vegetationtype,ziformula = ~ 1,family = poisson, data = META)
sim_res <- simulateResiduals(mFr)
par(mfrow=c(2,2))
plot(sim_res)        # overall diagnostic plots
plotResiduals(sim_res, form = META$Treatment)
plotResiduals(sim_res, form = META$Vegetationtype)
testDispersion(sim_res)   # overdispersion check
testZeroInflation(sim_res)  # zero-inflation check
summary(mFr)


